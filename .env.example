# ============================================================
# Sintaxia · variables de entorno del backend
# Copia este archivo como .env y completa los valores.
#   cp .env.example .env
# ============================================================

# --- Servidor -------------------------------------------------
PUERTO=3000
URL_FRONT=http://localhost:5173
URL_API=http://localhost:3000

# --- Base de datos MySQL --------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NOMBRE=sintaxia
DB_USUARIO=sintaxia
DB_CLAVE=sintaxia

# --- Sesion ---------------------------------------------------
# Cadena larga y secreta con la que se firman las sesiones.
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRETO_SESION=

# --- Login con Google -----------------------------------------
# https://console.cloud.google.com/apis/credentials
# Tipo: "ID de cliente de OAuth" -> "Aplicacion web"
# URI de redireccion autorizado:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Login con GitHub -----------------------------------------
# https://github.com/settings/developers -> "New OAuth App"
# Authorization callback URL:
#   http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Login de prueba ------------------------------------------
# Permite entrar con un usuario falso sin configurar OAuth.
# Sirve para desarrollar y para mostrar la app.
# Se ignora automaticamente si NODE_ENV=produccion.
PERMITIR_LOGIN_DEMO=true
