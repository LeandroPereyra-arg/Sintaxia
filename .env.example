# ============================================================
# Sintaxia · variables de entorno
# Copia este archivo como .env y completa los valores.
#   cp .env.example .env
#
# El .env real NUNCA se sube al repositorio (esta en .gitignore).
# Este archivo de ejemplo solo dice QUE variables hacen falta:
# no lleva ninguna credencial.
# ============================================================

# ============================================================
# 1. Supabase · contenido de los cursos (lo usa el navegador)
# ============================================================
# Estos dos valores estan en el panel de Supabase, en
#   Project Settings -> API  (o "API Keys").
#
# Todo lo que empieza con VITE_ queda DENTRO del paquete que se
# descarga el navegador. Que sea una variable de entorno no la
# convierte en secreta: cualquiera que abra la aplicacion puede
# leerla. Por eso aca va solamente la clave publicable, que es
# la que esta pensada para el cliente y esta limitada por las
# politicas de RLS (ver supabase/03-politicas-rls.sql).
#
# NUNCA poner aca la clave service_role ni ninguna clave secreta:
# esa clave saltea RLS y daria acceso total a la base.

# URL del proyecto, con la forma https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Clave publicable (publishable / anon key) del proyecto.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ============================================================
# 2. API de cuentas (Express + MySQL, etapa 2)
# ============================================================

# --- Servidor -------------------------------------------------
PUERTO=3000
URL_FRONT=http://localhost:5173
URL_API=http://localhost:3000

# --- Base de datos MySQL --------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NOMBRE=sintaxia
DB_USUARIO=sintaxia
DB_CLAVE=sintaxia

# --- Sesion ---------------------------------------------------
# Cadena larga y secreta con la que se firman las sesiones.
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRETO_SESION=

# --- Login con Google -----------------------------------------
# https://console.cloud.google.com/apis/credentials
# Tipo: "ID de cliente de OAuth" -> "Aplicacion web"
# URI de redireccion autorizado:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Login con GitHub -----------------------------------------
# https://github.com/settings/developers -> "New OAuth App"
# Authorization callback URL:
#   http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Login de prueba ------------------------------------------
# Permite entrar con un usuario falso sin configurar OAuth.
# Sirve para desarrollar y para mostrar la app.
# Se ignora automaticamente si NODE_ENV=produccion.
PERMITIR_LOGIN_DEMO=true
